---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Home - English Edition" lang="en" dir="ltr">
  <section style="margin-bottom: 2rem;">
    <h2 style="border-left: 4px solid #ef4444; padding-left: 0.5rem; color: #f8fafc;">Top News</h2>
    
    <!-- Featured Big News Card -->
    <div style="background: #1e293b; border-radius: 8px; overflow: hidden; border: 1px solid #334155; margin-bottom: 2rem;">
      <img src="https://images.unsplash.com/photo-1585829365295-ab7cd400c167?w=1200" alt="News Press" style="width: 100%; height: 350px; object-fit: cover;" />
      <div style="padding: 1.5rem;">
        <span style="background: #ef4444; color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; text-transform: uppercase; font-weight: bold;">Pakistan</span>
        <h1 style="margin: 0.5rem 0; font-size: 1.8rem; color: #f8fafc;">Aaj Ki Taza Khabar Portal Launched for Verified Bilingual News</h1>
        <p style="color: #94a3b8; font-size: 1rem; line-height: 1.5;">Welcome to Aaj Ki Taza Khabar, providing real-time, AI-assisted, multi-source verified reporting across Pakistan, Sports, Technology, and World affairs.</p>
        <span style="color: #64748b; font-size: 0.85rem;">Staff Writer • AI-Assisted • October 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
