---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="صفحہ اول - اردو ایڈیشن" lang="ur" dir="rtl">
  <section style="margin-bottom: 2rem;">
    <h2 style="border-right: 4px solid #ef4444; padding-right: 0.5rem; color: #f8fafc;">اہم ترین خبریں</h2>
    
    <!-- Featured Big News Card -->
    <div style="background: #1e293b; border-radius: 8px; overflow: hidden; border: 1px solid #334155; margin-bottom: 2rem;">
      <img src="https://images.unsplash.com/photo-1585829365295-ab7cd400c167?w=1200" alt="News Press" style="width: 100%; height: 350px; object-fit: cover;" />
      <div style="padding: 1.5rem;">
        <span style="background: #ef4444; color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold;">پاکستان</span>
        <h1 style="margin: 0.5rem 0; font-size: 1.8rem; color: #f8fafc;">آج کی تازہ خبر: باوثوق اور سچی خبروں کا نیا پلیٹ فارم</h1>
        <p style="color: #94a3b8; font-size: 1.1rem; line-height: 1.8;">آج کی تازہ خبر پر خوش آمدید! ہمارا مقصد پاکستان اور دنیا بھر سے مصدقہ اور باوثوق خبریں اردو اور انگریزی دونوں زبانوں میں فراہم کرنا ہے۔</p>
        <span style="color: #64748b; font-size: 0.85rem;">اسٹاف رپورٹر • آرٹیفیشل انٹیلی جنس کی معاونت سے • اکتوبر 2026</span>
      </div>
    </div>
  </section>
</BaseLayout>
